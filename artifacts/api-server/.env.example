# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB (Mongoose) ───────────────────────────────────────────────────────
# Your Atlas connection string — replace <user>, <pass>, <cluster>
# Free tier at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/talentiq?appName=Cluster0

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# 1. Go to https://dashboard.clerk.com → Create application
# 2. Choose "Email + Password" (+ any social providers you want)
# 3. API Keys section → copy Publishable key and Secret key
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# ─── OpenAI API ───────────────────────────────────────────────────────────────
# Used for: AI match scoring, assessment generation, resume skill extraction
# The app works without this — falls back gracefully on all AI endpoints
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ─── Resume Storage ───────────────────────────────────────────────────────────
# Uploaded files are stored under this path relative to the server process
# Default is ./uploads/resumes — no need to change this normally
# RESUME_UPLOAD_DIR=uploads/resumes
