# ─── Server Configuration ──────────────────────────────────────────────────
PORT=10000
NODE_ENV=production
BASE_URL=https://talentiq-api.onrender.com
FRONTEND_URL=https://talentiq-hire.vercel.app

# ─── Database (MongoDB Atlas) ───────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/talentiq?appName=Cluster0

# ─── Clerk Authentication ─────────────────────────────────────────────────
# Same Clerk instance for frontend and backend. Use live keys (pk_live/sk_live)
# in production; the proxy middleware forwards Clerk Frontend API calls through
# your domain at /api/__clerk.
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY

# ─── OpenAI API Key (AI Match & Integrity Assessments) ──────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ─── CORS Allowlist (comma-separated origins) ───────────────────────────────
CORS_ORIGINS=https://talentiq-hire.vercel.app

# ─── Dev Auth Fallback (Security) ───────────────────────────────────────────
# ONLY enable for local development. In production this is rejected at startup
# even if set to "true".
ALLOW_DEV_AUTH=true

# ─── Resume Storage ─────────────────────────────────────────────────────────
# Render disk is ephemeral; mount a persistent disk or use object storage.
UPLOADS_DIR=uploads/resumes

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
