# ─── Server Configuration ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8081

# ─── Database (MongoDB Atlas) ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/talentiq?appName=Cluster0

# ─── Google OAuth 2.0 / OpenID Connect Credentials ──────────────────────────
# Generated at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI in Google Cloud Console must match GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=your-secure-random-session-secret-key-at-least-32-chars
AUTH_SECRET=your-secure-random-auth-secret-string-at-least-32-chars

# ─── Clerk Authentication (Optional) ─────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# ─── OpenAI API Key (AI Match & Integrity Assessments) ──────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ─── Resume Storage ─────────────────────────────────────────────────────────
# RESUME_UPLOAD_DIR=uploads/resumes
