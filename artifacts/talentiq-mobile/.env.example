# Backend API URL (default: localhost:5000)
EXPO_PUBLIC_DOMAIN=localhost:5000

# Google OAuth 2.0 Web Client ID (from https://console.cloud.google.com/apis/credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional custom redirect URI (defaults to backend callback http://localhost:5000/api/auth/google/callback on web)
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Clerk Publishable Key (optional, from https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
