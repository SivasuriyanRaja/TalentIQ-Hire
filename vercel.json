{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "artifacts/talentiq-mobile",
      "buildCommand": "pnpm exec expo export --platform web",
      "outputDirectory": "dist"
    },
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/auth/google/callback",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
