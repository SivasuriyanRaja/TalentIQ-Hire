{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm run build:web",
  "outputDirectory": "artifacts/talentiq-mobile/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://talentiq-hire.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://talentiq-hire.onrender.com/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
